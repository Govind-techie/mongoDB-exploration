<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat</title>
    <style>
        input{
            margin-bottom: 10px;
        }
        textarea {
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <form action="/chats" method="post">
        <input type="text" placeholder="Enter sender name" name="from">
        <br>
        <input type="text" placeholder="Enter reciever name" name="to">
        <br>
        <textarea name="msg" placeholder="write your message here"></textarea>
        <br>
        <button type="submit">Send</button>
    </form>
</body>
</html>