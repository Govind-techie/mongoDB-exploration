<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat App</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h3>All Chats!</h3>
    <% chats.forEach(chat => { %>
        <div class="chat">
            <p>From: <%= chat.from %></p>
            <p>To: <%= chat.to %></p>
            <div class="msg">
                <p><%= chat.msg %></p>
            </div>
            <p>Date: <%= chat.created_at.toDateString() %></p>
            <p>Time: <%= chat.created_at.toTimeString().slice(0,5) %></p>
            <div class="btns">
                <form action="/chat/<%= chat.id %>/edit" method="get">
                    <button type="submit">Edit</button>
                </form>
                <form action="/chat/<%= chat.id %>?_method=DELETE" method="post">
                    <button type="submit">Delete</button>
                </form>
            </div>
        </div>
        <hr>
    <% }) %>

    <form action="/chat/new" method="get">
        <button type="submit">New Chat</button>
    </form>
</body>
</html>