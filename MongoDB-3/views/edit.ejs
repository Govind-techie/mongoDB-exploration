<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>
<body>
    <h3>Edit Chat here!</h3>
    <form action="/chat/<%=chat.id%>?_method=PUT" method="post">
        <textarea name="msg"><%= chat.msg %></textarea>
        <br>
        <button type="submit" style="margin-top: 5px;">Done</button>
    </form>
</body>
</html>